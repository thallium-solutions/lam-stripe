# expect: StripeCardError: Your card was declined. [status=402 type=card_error code=card_declined decline_code=insufficient_funds param=payment_method request_id=req_42]
# expect: card_error card_declined insufficient_funds payment_method req_42 https://stripe.com/docs/error-codes/card-declined
# expect: true false false
# expect: StripeInvalidRequestError StripeAuthenticationError StripePermissionError StripeRateLimitError StripeIdempotencyError StripeApiError StripeInvalidRequestError StripeCardError
# expect: StripeApiError: upstream exploded [status=502]
# expect: upstream exploded
# expect: StripeApiError: stripe request failed with status 500 [status=500]
# expect: StripeInvalidRequestError: No such customer: 'cus_x' [status=404 type=invalid_request_error code=resource_missing param=id]
# expect: "resource_missing"
# expect: true
# expect: narrowed StripeCardError card_declined
# expect: caught StripeValidationError amount
# expect: true
# expect: StripeConnectionError true
# expect: StripeConfigError StripeSignatureError
# expect: 7

from @lam/stripe import StripeError
from lamerrors import Result, Error

func charge(amount: int) -> Result[int] {
    if amount <= 0 {
        return Result.Err(StripeError.validation("amount must be greater than zero", "amount"))
    }
    return Result.Ok(amount)
}

func pipeline(amount: int) -> Result[int] {
    value: int = charge(amount)?
    return Result.Ok(value * 2)
}

func describe(err: any) -> str {
    match err {
        case StripeError() as se {
            return f"narrowed {se.kind} {se.code}"
        }
        case _ {
            return "other"
        }
    }
}

func main() {
    card: StripeError = StripeError.fromResponse(402, "{\"error\":{\"type\":\"card_error\",\"code\":\"card_declined\",\"decline_code\":\"insufficient_funds\",\"param\":\"payment_method\",\"message\":\"Your card was declined.\",\"doc_url\":\"https://stripe.com/docs/error-codes/card-declined\"}}", "req_42")
    print(card)
    print(f"{card.type} {card.code} {card.declineCode} {card.param} {card.requestId} {card.docUrl}")
    print(card.isCardError(), card.isRateLimit(), card.isConnectionError())

    kinds: list[str] = [
        StripeError.kindFor(400, ""),
        StripeError.kindFor(401, "invalid_request_error"),
        StripeError.kindFor(403, ""),
        StripeError.kindFor(429, ""),
        StripeError.kindFor(400, "idempotency_error"),
        StripeError.kindFor(500, "api_error"),
        StripeError.kindFor(404, ""),
        StripeError.kindFor(402, "")
    ]
    print(" ".join(kinds))

    # Non-JSON bodies become the message; empty bodies get a generic one.
    proxy: StripeError = StripeError.fromResponse(502, "upstream exploded")
    print(proxy)
    print(proxy.body)
    print(StripeError.fromResponse(500, ""))

    missing: StripeError = StripeError.fromResponse(404, "{\"error\":{\"type\":\"invalid_request_error\",\"code\":\"resource_missing\",\"param\":\"id\",\"message\":\"No such customer: 'cus_x'\"}}")
    print(missing)
    print(missing.raw["code"])

    # A StripeError is an lamerrors.Error: kind/message work everywhere.
    asError: Error = card
    print(asError.kind == "StripeCardError" and asError.message == "Your card was declined.")
    print(describe(card))

    do {
        _ = pipeline(0)?
        print("unreachable")
    } catch err {
        se: StripeError = StripeError.of(err)
        print(f"caught {err.kind} {se.param}")
    }
    print(StripeError.of(Error("Other", "x")) == None)

    conn: StripeError = StripeError.connection("GET", "/v1/balance", Error("HttpError", "refused"))
    print(conn.kind, conn.retryable)
    print(StripeError.config("x").kind, StripeError.signature("y").kind)
    print(pipeline(7).unwrap() // 2)
}
