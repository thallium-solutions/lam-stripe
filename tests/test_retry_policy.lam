# expect: true true true true true true
# expect: false false false false
# expect: true false true
# expect: 500 1000 2000 4000 5000 5000
# expect: 250 500 1000
# expect: 375
# expect: 3000 5000 500
# expect: 0 0
# expect: true
from @lam/stripe import Stripe

func main() {
    # Network errors (status 0), lock timeouts, rate limits and 5xx retry.
    print(Stripe.shouldRetry(0), Stripe.shouldRetry(409), Stripe.shouldRetry(429), Stripe.shouldRetry(500), Stripe.shouldRetry(502), Stripe.shouldRetry(503))
    print(Stripe.shouldRetry(400), Stripe.shouldRetry(401), Stripe.shouldRetry(402), Stripe.shouldRetry(404))
    # Stripe-Should-Retry wins over the status code.
    print(Stripe.shouldRetry(400, "true"), Stripe.shouldRetry(503, " False "), Stripe.shouldRetry(500, "maybe"))

    # Exponential backoff capped at the maximum (full jitter = 1.0).
    delays: list[int] = [Stripe.retryDelayMs(n, 500, 5000) for n in range(1, 7)]
    print(" ".join([str(d) for d in delays]))
    # Jitter 0 halves the delay; 0.5 lands in the middle.
    print(Stripe.retryDelayMs(1, 500, 5000, 0, 0.0), Stripe.retryDelayMs(2, 500, 5000, 0, 0.0), Stripe.retryDelayMs(3, 500, 5000, 0, 0.0))
    print(Stripe.retryDelayMs(1, 500, 5000, 0, 0.5))
    # Retry-After raises the delay, still capped.
    print(Stripe.retryDelayMs(1, 500, 5000, 3), Stripe.retryDelayMs(1, 500, 5000, 60), Stripe.retryDelayMs(1, 500, 5000, 0, 7.0))
    print(Stripe.retryDelayMs(1, 0, 0), Stripe.retryDelayMs(4, 0, 100, 0, -1.0))
    # Every jittered delay stays within [50%, 100%] of the backoff step.
    ok: bool = true
    for i in range(100) {
        d: int = Stripe.retryDelayMs(3, 400, 10000, 0, float(i) / 100.0)
        if d < 800 or d > 1600 {
            ok = false
        }
    }
    print(ok)
}
